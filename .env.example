# SmartPark Client Configuration

# Demo Mode: true for simulated standalone frontend prototype, false to connect to FastAPI backend
VITE_DEMO_MODE=true

# API Endpoints (used when VITE_DEMO_MODE=false)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/live

# Prototype Hardware Metadata
VITE_MAX_SLOTS=6
VITE_LOCATION_NAME="Innovation Lab Lot 1"
