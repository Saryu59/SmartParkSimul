# SmartPark Backend Environment Configuration

# Server Settings
PROJECT_NAME="SmartPark API"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (Frontend origins allowed)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Connection
# PostgreSQL URL format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# Synchronous URL for Alembic: postgresql://<username>:<password>@<host>:<port>/<database>
# Development SQLite fallback: sqlite+aiosqlite:///./smartpark.db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/smartpark"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/smartpark"

# Security & JWT Authentication
SECRET_KEY="smartpark-super-secure-production-ready-jwt-secret-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Sensor Integration Mode: "demo" or "hardware"
# - "demo": accepts simulated sensor triggers from authenticated demo/admin frontend
# - "hardware": rejects simulated triggers; requires authenticated ESP32 device requests
SENSOR_MODE="demo"
HARDWARE_DEVICE_TOKEN="esp32-hw-token-smartpark-node-01"

# Facility & Operational Rules
DEFAULT_GRACE_PERIOD_MINUTES=10
MAX_SLOTS=6
LOCATION_NAME="Innovation Lab Parking Lot 1"
